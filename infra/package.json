  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "aws-cdk": "2.1143.0",
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
