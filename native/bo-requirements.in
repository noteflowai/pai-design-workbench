# Optional Bayesian-optimisation strategy for the physics lane (BoTorch qLogNEHVI), installed into the same physics venv.
# CPU PyTorch from the official PyTorch CPU index (no CUDA wheels; the solver, not the GP, dominates run time).
# Constrained to the physics lock so shared packages keep their exact versions. Regenerate with:
#   uv pip compile --python-version 3.12 --python-platform x86_64-manylinux_2_31 --generate-hashes --emit-index-url \
#     --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match \
#     -c native/physics-requirements.in native/bo-requirements.in -o native/bo-requirements.txt
botorch==0.18.1
gpytorch==1.15.2
linear-operator==0.6.1
torch==2.14.1+cpu
